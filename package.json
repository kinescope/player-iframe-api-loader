{
  "name": "@kinescope/player-iframe-api-loader",
  "version": "0.10.0",
  "description": "Kinescope Player Iframe API loader and TypeScript type definitions",
  "author": "VZH (https://github.com/vlazh)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.cjs",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./types/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./types/index.cjs"
      }
    },
    "./react/KinescopePlayer": {
      "import": {
        "types": "./react/KinescopePlayer.d.ts",
        "default": "./react/KinescopePlayer.js"
      },
      "require": {
        "types": "./react/KinescopePlayer.d.cts",
        "default": "./react/KinescopePlayer.cjs"
      }
    },
    "./package.json": "./package.json",
    "./*.js": {
      "import": {
        "types": "./*.d.ts",
        "default": "./*.js"
      },
      "require": {
        "types": "./*.d.cts",
        "default": "./*.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./*.d.ts",
        "default": "./*.js"
      },
      "require": {
        "types": "./*.d.cts",
        "default": "./*.cjs"
      }
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinescope/player-iframe-api-loader.git"
  },
  "keywords": [
    "player",
    "video",
    "kinescope",
    "iframe",
    "api",
    "loader"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:loader": "tsc -p tsconfig.json",
    "build:react": "node esbuild.mjs",
    "build:package": "node scripts/prepare-dist.mjs",
    "build": "npm run clean && npm run build:loader && npm run build:react && npm run build:package",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint dist --pack npm && attw --pack dist --ignore-rules false-export-default && node scripts/check-dist.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "7.29.13",
    "@babel/eslint-parser": "7.29.13",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@js-toolkit/configs": "3.109.2",
    "@js-toolkit/react-hooks": "1.55.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "yarn@4.10.3"
}
